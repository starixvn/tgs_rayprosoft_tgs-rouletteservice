<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.RouletteServices.Clients</RootNamespace>
    <PackageId>Tgs.RouletteSignInClient</PackageId>
    <Version>0.0.3</Version>
    <Authors>Raypro</Authors>
    <Product>Tgs.RouletteSignInClient</Product>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-rouletteservice</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-rouletteservice.git</RepositoryUrl>
    <PackageTags>Tgs Roulette SignIn</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.1" />
    <PackageReference Include="Grpc.Tools" Version="2.46.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.2.32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="Tgs.MessageQueue.Nats" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Tgs.RouletteService\Protos\roulette.proto" Link="Protos\roulette.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

</Project>
